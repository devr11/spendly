import sqlite3
from flask import g
from werkzeug.security import generate_password_hash

DATABASE = 'expense_tracker.db'


def get_db():
    """
    Get a database connection.
    Creates a new connection if one doesn't exist for the current request context.
    Returns a connection with row_factory set to sqlite3.Row for dict-like access.
    """
    if 'db' not in g:
        g.db = sqlite3.connect(
            DATABASE,
            detect_types=sqlite3.PARSE_DECLTYPES
        )
        g.db.row_factory = sqlite3.Row
        # Enable foreign key constraints
        g.db.execute('PRAGMA foreign_keys = ON')

    return g.db


def close_db(e=None):
    """
    Close the database connection if it exists.
    Called automatically at the end of each request.
    """
    db = g.pop('db', None)

    if db is not None:
        db.close()


def init_db():
    """
    Initialize the database schema.
    Creates tables if they don't exist: users, expenses.
    Safe to run multiple times (uses CREATE TABLE IF NOT EXISTS).
    """
    db = get_db()

    # Users table
    db.execute('''
        CREATE TABLE IF NOT EXISTS users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            email TEXT UNIQUE NOT NULL,
            password_hash TEXT NOT NULL,
            created_at TEXT DEFAULT (datetime('now'))
        )
    ''')

    # Expenses table
    db.execute('''
        CREATE TABLE IF NOT EXISTS expenses (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id INTEGER NOT NULL,
            amount REAL NOT NULL,
            category TEXT NOT NULL,
            date TEXT NOT NULL,
            description TEXT,
            created_at TEXT DEFAULT (datetime('now')),
            FOREIGN KEY (user_id) REFERENCES users (id) ON DELETE CASCADE
        )
    ''')

    # Create indexes for better query performance
    db.execute('''
        CREATE INDEX IF NOT EXISTS idx_expenses_user_id
        ON expenses (user_id)
    ''')

    db.execute('''
        CREATE INDEX IF NOT EXISTS idx_expenses_date
        ON expenses (date)
    ''')

    db.execute('''
        CREATE INDEX IF NOT EXISTS idx_expenses_category
        ON expenses (category)
    ''')

    db.commit()


def seed_db():
    """
    Seed the database with sample development data.
    Creates a demo user and sample expenses for development/testing.
    Safe to run multiple times (checks if data already exists).
    """
    db = get_db()

    # Check if data already exists
    existing_users = db.execute('SELECT COUNT(*) as count FROM users').fetchone()
    if existing_users['count'] > 0:
        print('Database already seeded. Skipping...')
        return

    # Create demo user
    cursor = db.execute(
        'INSERT INTO users (name, email, password_hash) VALUES (?, ?, ?)',
        ('Demo User', 'demo@spendly.com', generate_password_hash('demo123'))
    )
    demo_user_id = cursor.lastrowid

    # Create 8 sample expenses for demo user
    expenses = [
        (demo_user_id, 45.99, 'Food', '2026-09-15', 'Weekly grocery shopping'),
        (demo_user_id, 12.50, 'Transport', '2026-09-16', 'Bus fare'),
        (demo_user_id, 150.00, 'Bills', '2026-09-10', 'Internet bill'),
        (demo_user_id, 35.00, 'Health', '2026-09-13', 'Pharmacy'),
        (demo_user_id, 89.00, 'Entertainment', '2026-09-14', 'Concert tickets'),
        (demo_user_id, 200.00, 'Shopping', '2026-09-12', 'New shoes'),
        (demo_user_id, 25.00, 'Other', '2026-09-17', 'Miscellaneous'),
        (demo_user_id, 8.75, 'Food', '2026-09-18', 'Coffee'),
    ]

    for user_id, amount, category, date, description in expenses:
        db.execute(
            '''INSERT INTO expenses (user_id, amount, category, date, description)
               VALUES (?, ?, ?, ?, ?)''',
            (user_id, amount, category, date, description)
        )

    db.commit()
    print('Database seeded successfully!')
    print(f'Created demo user (email: demo@spendly.com, password: demo123)')
    print(f'Created {len(expenses)} sample expenses')
