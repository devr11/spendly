@app.route("/register", methods=["GET", "POST"])
def register():
    if request.method == "POST":
        # Extract form data
        name = request.form.get("name", "").strip()
        email = request.form.get("email", "").strip()
        password = request.form.get("password", "")

        # Server-side validation
        if not name:
            return render_template("register.html", error="Name is required", name=name, email=email)

        if not email:
            return render_template("register.html", error="Email is required", name=name, email=email)

        if not password:
            return render_template("register.html", error="Password is required", name=name, email=email)

        if len(password) < 8:
            return render_template("register.html", error="Password must be at least 8 characters", name=name, email=email)

        # Email format validation
        if '@' not in email or '.' not in email.split('@')[-1]:
            return render_template("register.html", error="Please enter a valid email address", name=name, email=email)

        # Hash the password
        password_hash = generate_password_hash(password)

        # Insert user into database
        try:
            db = get_db()
            cursor = db.execute(
                'INSERT INTO users (name, email, password_hash) VALUES (?, ?, ?)',
                (name, email, password_hash)
            )
            user_id = cursor.lastrowid
            db.commit()

            # Log user in and redirect to landing
            session['user_id'] = user_id
            flash('Account created successfully! Welcome to Spendly.')
            return redirect(url_for('landing'))

        except sqlite3.IntegrityError:
            return render_template("register.html", error="Email already registered", name=name, email=email)

    return render_template("register.html")


@app.route("/login", methods=["GET", "POST"])
def login():
    if request.method == "POST":
        # Extract form data
        email = request.form.get("email", "").strip()
        password = request.form.get("password", "")

        # Server-side validation
        if not email:
            return render_template("login.html", error="Email is required", email=email)

        if not password:
            return render_template("login.html", error="Password is required", email=email)

        # Query database for user by email
        db = get_db()
        user = db.execute(
            'SELECT id, password_hash FROM users WHERE email = ?',
            (email,)
        ).fetchone()

        # Verify user exists and password is correct
        if user is None or not check_password_hash(user['password_hash'], password):
            return render_template("login.html", error="Invalid email or password", email=email)

        # Login successful - store user_id in session
        session['user_id'] = user['id']
        flash('Welcome back! You are now logged in.')
        return redirect(url_for('landing'))

    return render_template("login.html")


